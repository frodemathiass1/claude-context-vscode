{
  "name": "claude-context",
  "displayName": "Claude Context",
  "description": "Shows the context window of every live Claude Code session in a VS Code panel or a browser tab, updated in real time.",
  "version": "0.21.0",
  "publisher": "frodemathiassen",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/frodemathiass1/claude-context-vscode"
  },
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": ["Other"],
  "main": "extension.js",
  "bin": {
    "claude-context": "server.cjs"
  },
  "activationEvents": ["onView:claudeContext.panel"],
  "contributes": {
    "configuration": {
      "title": "Claude Context",
      "properties": {
        "claudeContext.claudeDir": {
          "type": "string",
          "default": "",
          "description": "Folder Claude Code stores its data in. Empty: CLAUDE_CONFIG_DIR, else ~/.claude. The panel reads from the new folder as soon as it changes."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeContext",
          "title": "Claude Context",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "claudeContext": [
        {
          "type": "webview",
          "id": "claudeContext.panel",
          "name": "Claude sessions"
        }
      ]
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
